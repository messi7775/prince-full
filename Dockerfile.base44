# Base44 dev image for the PHP + Apache app.
# Plain runtime base — source is bind-mounted at runtime, not baked in.
FROM php:8.2-apache

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

# PDO MySQL driver + Apache rewrite for .htaccess
RUN docker-php-ext-install pdo_mysql \
 && a2enmod rewrite \
 && sed -i 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf
